# Endereço público do site, sem barra no final (ex.: https://flavia-menegossi.vercel.app).
# Necessário para a imagem de prévia aparecer no LinkedIn. Preencha depois de publicar.
VITE_SITE_URL=

# ID do formulário do Formspree (formspree.io → New form → copie o ID, ex.: xyzabcde).
# Vazio: o formulário abre o app de e-mail com a mensagem pronta.
VITE_FORMSPREE_ID=
